{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RunMMO",
  "version": "0.0.1",
  "identifier": "de.agentz.runmmo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RunMMO",
        "width": 450,
        "height": 800,
        "minWidth": 281,
        "minHeight": 500,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false,
        "skipTaskbar": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ibimspumo/RunMMO/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGNkYyOTkzRjc4QzY4RjMKUldUemFJejNreWx2VHdabUlEb3hQdGxvdGtmZm9IbndLNnBYQytPcjg1dEdDUFg2U3ordkNoUFgK",
      "dialog": false
    }
  }
}
